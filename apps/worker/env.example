# Redis Configuration
REDIS_URL=redis://localhost:6379/0
# OR individual settings:
REDIS_PASSWORD=your_redis_password

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@place value Portal.com

# App Configuration
APP_NAME=place value Portal
APP_URL=https://place value Portal.com
APP_DOMAIN=place value Portal.com
HELP_URL=https://place value Portal.com/help

# Worker Configuration
WORKER_MAIL_CONCURRENCY=5
NOTIFICATION_WORKER_CONCURRENCY=10
WORKER_DATA_PROCESSING_CONCURRENCY=3

# Logging
LOG_LEVEL=info
