<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assessment Result - {{assessmentTitle}}</title>
    <style>
        body {
            margin: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background-color: #0f172a;
            color: #0f172a;
        }

        .wrapper {
            padding: 32px 12px;
        }

        .card {
            max-width: 680px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 30px 60px -15px rgba(15, 23, 42, 0.35);
            border: 1px solid rgba(15, 23, 42, 0.08);
        }

        .hero {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: #ffffff;
            padding: 36px 32px 40px;
            position: relative;
        }

        .hero h1 {
            margin: 0;
            font-size: 22px;
            letter-spacing: 1px;
            text-transform: uppercase;
            opacity: 0.85;
        }

        .hero h2 {
            margin: 16px 0 8px;
            font-size: 32px;
        }

        .hero p {
            margin: 0;
            opacity: 0.9;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 16px;
            margin: -40px 24px 24px;
        }

        .stat {
            background: #ffffff;
            border-radius: 20px;
            padding: 20px;
            text-align: center;
            border: 1px solid rgba(15, 23, 42, 0.06);
        }

        .stat-label {
            font-size: 13px;
            text-transform: uppercase;
            color: #64748b;
            letter-spacing: 0.08em;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 700;
            margin-top: 6px;
            color: #0f172a;
        }

        .section {
            padding: 0 32px 32px;
        }

        .section h3 {
            margin: 32px 0 12px;
            font-size: 18px;
            color: #0f172a;
        }

        .list {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .list li {
            display: flex;
            justify-content: space-between;
            padding: 14px 0;
            border-bottom: 1px solid rgba(15, 23, 42, 0.08);
            font-size: 15px;
        }

        .cta {
            margin-top: 32px;
            text-align: center;
        }

        .button {
            display: inline-block;
            padding: 14px 28px;
            border-radius: 999px;
            background: #1d4ed8;
            color: #ffffff;
            text-decoration: none;
            font-weight: 600;
            margin: 4px;
        }

        .footer {
            text-align: center;
            padding: 16px 32px 32px;
            font-size: 13px;
            color: #94a3b8;
        }

        @media (max-width: 640px) {
            .hero {
                padding: 28px 24px 36px;
            }

            .section {
                padding: 0 24px 24px;
            }

            .stats {
                margin: -32px 20px 20px;
            }
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="card">
            <div class="hero">
                <h1>Assessment Result</h1>
                <h2>{{assessmentTitle}}</h2>
                <p>Hi {{userName}}, here is a summary of your performance.</p>
            </div>

            <div class="stats">
                <div class="stat">
                    <div class="stat-label">Score</div>
                    <div class="stat-value">{{obtainedMarks}} / {{totalMarks}}</div>
                </div>
                <div class="stat">
                    <div class="stat-label">Percentage</div>
                    <div class="stat-value">{{formatPercentage percentage}}</div>
                </div>
                <div class="stat">
                    <div class="stat-label">Status</div>
                    <div class="stat-value">{{#if isPassed}}Passed{{else}}Need Review{{/if}}</div>
                </div>
                <div class="stat">
                    <div class="stat-label">Time Taken</div>
                    <div class="stat-value">{{formatDuration timeTaken}}</div>
                </div>
            </div>

            <div class="section">
                <h3>Details</h3>
                <ul class="list">
                    <li><span>Assessment ID</span><span>{{assessmentId}}</span></li>
                    <li><span>Submitted At</span><span>{{formatDate submittedAt}}</span></li>
                    <li><span>Correct Answers</span><span>{{correctAnswers}}</span></li>
                    <li><span>Incorrect Answers</span><span>{{incorrectAnswers}}</span></li>
                    <li><span>Unattempted</span><span>{{unattemptedQuestions}}</span></li>
                </ul>

                {{#if recommendations.length}}
                <h3 style="margin-top: 28px;">Recommendations</h3>
                <ul class="list">
                    {{#each recommendations}}
                    <li><span>{{this}}</span></li>
                    {{/each}}
                </ul>
                {{/if}}

                <div class="cta">
                    <a class="button" href="{{resultUrl}}" target="_blank" rel="noopener noreferrer">View Detailed Report</a>
                    {{#if dashboardUrl}}
                    <a class="button" style="background:#0f172a" href="{{dashboardUrl}}" target="_blank" rel="noopener noreferrer">Go to Dashboard</a>
                    {{/if}}
                </div>
            </div>

            <div class="footer">
                Sent by {{appName}} • <a href="{{appUrl}}" style="color:#6366f1;">Visit dashboard</a>
            </div>
        </div>
    </div>
</body>
</html>

