<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assessment Result - {{assessmentTitle}}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background: linear-gradient(145deg, #0a0f1e 0%, #0f172a 100%);
            color: #0f172a;
            line-height: 1.5;
        }

        .wrapper {
            padding: 40px 20px;
        }

        .card {
            max-width: 680px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 32px;
            overflow: hidden;
            box-shadow: 0 30px 55px -20px rgba(0, 0, 0, 0.4), 0 1px 2px rgba(0, 0, 0, 0.05);
            transition: transform 0.2s ease;
        }

        /* hero section with premium gradient */
        .hero {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #a855f7 100%);
            color: #ffffff;
            padding: 40px 36px 48px;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: "";
            position: absolute;
            top: -30%;
            right: -20%;
            width: 280px;
            height: 280px;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 50%;
            pointer-events: none;
        }

        .hero::after {
            content: "";
            position: absolute;
            bottom: -20%;
            left: -10%;
            width: 200px;
            height: 200px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
            pointer-events: none;
        }

        .hero h1 {
            margin: 0;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            opacity: 0.85;
            position: relative;
            z-index: 1;
        }

        .hero h2 {
            margin: 18px 0 12px;
            font-size: 32px;
            font-weight: 700;
            letter-spacing: -0.4px;
            position: relative;
            z-index: 1;
            line-height: 1.3;
        }

        .hero p {
            margin: 0;
            opacity: 0.92;
            font-size: 16px;
            position: relative;
            z-index: 1;
        }

        /* stats cards - floating effect */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 16px;
            margin: -40px 28px 28px;
            position: relative;
            z-index: 5;
        }

        .stat-card {
            background: #ffffff;
            border-radius: 24px;
            padding: 20px 12px;
            text-align: center;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06), 0 1px 2px rgba(0, 0, 0, 0.02);
            border: 1px solid rgba(79, 70, 229, 0.12);
            transition: all 0.2s ease;
        }

        .stat-label {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #6b7280;
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 800;
            color: #0f172a;
            line-height: 1.2;
        }

        .stat-value small {
            font-size: 14px;
            font-weight: 500;
            color: #6c7a91;
        }

        /* status badge dynamic */
        .status-badge {
            display: inline-block;
            padding: 4px 0;
        }
        
        .status-pass {
            color: #10b981;
        }
        
        .status-review {
            color: #f59e0b;
        }

        /* main content section */
        .section {
            padding: 0 36px 36px;
        }

        .section-title {
            font-size: 18px;
            font-weight: 700;
            color: #0f172a;
            margin: 28px 0 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section-title:first-of-type {
            margin-top: 8px;
        }

        .details-list {
            margin: 0;
            padding: 0;
            list-style: none;
            background: #fafcff;
            border-radius: 24px;
            border: 1px solid #eef2f8;
            overflow: hidden;
        }

        .details-list li {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 20px;
            border-bottom: 1px solid #edf2f7;
            font-size: 15px;
            font-weight: 500;
            color: #1f2937;
        }

        .details-list li:last-child {
            border-bottom: none;
        }

        .details-list li span:first-child {
            color: #5b6e8c;
            font-weight: 450;
        }

        .details-list li span:last-child {
            font-weight: 600;
            color: #0f172a;
        }

        /* recommendations list */
        .recommendations-list {
            margin: 0;
            padding: 0;
            list-style: none;
            background: #fefce8;
            border-radius: 20px;
            border: 1px solid #fef3c7;
            overflow: hidden;
        }

        .recommendations-list li {
            padding: 14px 20px;
            border-bottom: 1px solid #fde68a;
            font-size: 14px;
            color: #854d0e;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .recommendations-list li:last-child {
            border-bottom: none;
        }

        .recommendations-list li:before {
            content: "💡";
            font-size: 16px;
        }

        /* CTA buttons */
        .cta-group {
            margin-top: 36px;
            text-align: center;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 14px;
        }

        .btn-primary {
            display: inline-block;
            padding: 14px 32px;
            border-radius: 48px;
            background: linear-gradient(105deg, #4f46e5 0%, #6366f1 100%);
            color: #ffffff;
            text-decoration: none;
            font-weight: 600;
            font-size: 15px;
            box-shadow: 0 4px 10px rgba(79, 70, 229, 0.25);
            transition: all 0.2s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(79, 70, 229, 0.3);
        }

        .btn-secondary {
            display: inline-block;
            padding: 14px 32px;
            border-radius: 48px;
            background: #0f172a;
            color: #ffffff;
            text-decoration: none;
            font-weight: 600;
            font-size: 15px;
            transition: all 0.2s ease;
            border: 1px solid #1e293b;
        }

        .btn-secondary:hover {
            background: #1e293b;
            transform: translateY(-1px);
        }

        /* footer */
        .footer {
            text-align: center;
            padding: 24px 36px 36px;
            font-size: 12px;
            color: #94a3b8;
            border-top: 1px solid #eef2f8;
            margin-top: 12px;
        }

        .footer a {
            color: #6366f1;
            text-decoration: none;
            font-weight: 500;
        }

        .footer a:hover {
            text-decoration: underline;
        }

        .footer p {
            margin: 6px 0;
        }

        .divider-light {
            width: 48px;
            height: 2px;
            background: #e2e8f0;
            margin: 14px auto;
            border-radius: 2px;
        }

        @media (max-width: 640px) {
            .wrapper {
                padding: 24px 16px;
            }
            .hero {
                padding: 32px 24px 40px;
            }
            .hero h2 {
                font-size: 26px;
            }
            .section {
                padding: 0 24px 28px;
            }
            .stats-grid {
                margin: -32px 20px 24px;
                gap: 12px;
            }
            .stat-value {
                font-size: 24px;
            }
            .cta-group {
                flex-direction: column;
                align-items: stretch;
                gap: 12px;
            }
            .btn-primary, .btn-secondary {
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="card">
            <!-- hero section with gradient and greeting -->
            <div class="hero">
                <h1>ASSESSMENT RESULT</h1>
                <h2>{{assessmentTitle}}</h2>
                <p>Hi {{userName}}, here is a summary of your performance.</p>
            </div>

            <!-- stats cards: score, percentage, status, time taken -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-label">🎯 Score</div>
                    <div class="stat-value">{{obtainedMarks}} <small>/ {{totalMarks}}</small></div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">📊 Percentage</div>
                    <div class="stat-value">{{percentage}}<small>%</small></div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">🏆 Status</div>
                    <div class="stat-value">
                        {{#if isPassed}}
                        <span class="status-badge status-pass">✓ Passed</span>
                        {{else}}
                        <span class="status-badge status-review">⟳ Need Review</span>
                        {{/if}}
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">⏱️ Time Taken</div>
                    <div class="stat-value">{{timeTakenFormatted}}</div>
                </div>
            </div>

            <!-- details section -->
            <div class="section">
                <div class="section-title">
                    <span>📋</span> Assessment Details
                </div>
                <ul class="details-list">
                    <li><span>Assessment ID</span><span>{{assessmentId}}</span></li>
                    <li><span>Submitted At</span><span>{{submittedAtFormatted}}</span></li>
                    <li><span>✅ Correct Answers</span><span>{{correctAnswers}}</span></li>
                    <li><span>❌ Incorrect Answers</span><span>{{incorrectAnswers}}</span></li>
                    <li><span>⚪ Unattempted</span><span>{{unattemptedQuestions}}</span></li>
                </ul>

                <!-- recommendations section (if any) -->
                {{#if recommendations.length}}
                <div class="section-title" style="margin-top: 32px;">
                    <span>📌</span> Recommendations
                </div>
                <ul class="recommendations-list">
                    {{#each recommendations}}
                    <li>{{this}}</li>
                    {{/each}}
                </ul>
                {{/if}}

                <!-- performance insight message -->
                {{#if performanceTip}}
                <div style="margin-top: 28px; padding: 16px 20px; background: #f0f9ff; border-radius: 20px; border-left: 4px solid #4f46e5;">
                    <p style="font-size: 14px; color: #1e40af; display: flex; align-items: center; gap: 8px;">
                        <span>💡</span> {{performanceTip}}
                    </p>
                </div>
                {{else}}
                    {{#if isPassed}}
                    <div style="margin-top: 28px; padding: 16px 20px; background: #ecfdf5; border-radius: 20px; border-left: 4px solid #10b981;">
                        <p style="font-size: 14px; color: #065f46;">🎉 Great work! Keep up the momentum and review your detailed report to see where you excelled.</p>
                    </div>
                    {{else}}
                    <div style="margin-top: 28px; padding: 16px 20px; background: #fffbeb; border-radius: 20px; border-left: 4px solid #f59e0b;">
                        <p style="font-size: 14px; color: #92400e;">📚 Review your responses and try again. Every attempt brings you closer to mastery.</p>
                    </div>
                    {{/if}}
                {{/if}}

                <!-- call to action buttons -->
                <div class="cta-group">
                    <a href="{{resultUrl}}" class="btn-primary" target="_blank" rel="noopener noreferrer">
                        View Detailed Report →
                    </a>
                    {{#if dashboardUrl}}
                    <a href="{{dashboardUrl}}" class="btn-secondary" target="_blank" rel="noopener noreferrer">
                        Go to Dashboard
                    </a>
                    {{/if}}
                </div>
            </div>

            <!-- footer with app branding -->
            <div class="footer">
                <p>Sent by <strong>{{appName}}</strong></p>
                <div class="divider-light"></div>
                <p>
                    <a href="{{appUrl}}">{{appDomain}}</a> • 
                    Need help? <a href="{{helpUrl}}">Help Center</a>
                </p>
                <p style="margin-top: 10px; font-size: 11px;">This is an automated report — please do not reply directly.</p>
            </div>
        </div>
    </div>
</body>
</html>