<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Your Password - {{appName}}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.5;
            background-color: #f5f7fc;
            margin: 0;
            padding: 32px 20px;
        }

        .email-container {
            max-width: 560px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 28px;
            box-shadow: 0 20px 35px -12px rgba(0, 0, 0, 0.08), 0 1px 2px rgba(0, 0, 0, 0.02);
            overflow: hidden;
        }

        /* modern header with orange/warm gradient */
        .header {
            background: linear-gradient(125deg, #ea580c 0%, #f97316 50%, #fb923c 100%);
            padding: 40px 32px 36px;
            text-align: center;
            position: relative;
        }

        .lock-icon {
            width: 64px;
            height: 64px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 60px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            backdrop-filter: blur(2px);
        }

        .lock-icon span {
            font-size: 32px;
        }

        .header h1 {
            font-size: 28px;
            font-weight: 700;
            color: white;
            margin: 0 0 8px;
            letter-spacing: -0.3px;
        }

        .header p {
            font-size: 15px;
            color: rgba(255, 255, 255, 0.9);
            margin: 0;
        }

        /* content area */
        .content {
            padding: 36px 32px 32px;
            background: #ffffff;
        }

        .greeting h2 {
            font-size: 22px;
            font-weight: 600;
            color: #111928;
            margin-bottom: 12px;
        }

        .greeting p {
            font-size: 16px;
            color: #4a5568;
            margin-bottom: 24px;
        }

        /* reset button - warm orange */
        .btn-container {
            text-align: center;
            margin: 28px 0 24px;
        }

        .reset-button {
            display: inline-block;
            background: linear-gradient(105deg, #ea580c 0%, #f97316 100%);
            color: white;
            padding: 14px 32px;
            font-size: 16px;
            font-weight: 600;
            text-decoration: none;
            border-radius: 48px;
            box-shadow: 0 6px 14px rgba(234, 88, 12, 0.25);
            transition: all 0.2s ease;
            letter-spacing: -0.2px;
        }

        .reset-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 22px rgba(234, 88, 12, 0.3);
            background: linear-gradient(105deg, #c2410c 0%, #ea580c 100%);
        }

        /* link box for fallback */
        .link-box {
            margin: 24px 0 20px;
        }

        .link-label {
            font-size: 13px;
            font-weight: 500;
            color: #5b6e8c;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .link-label:before {
            content: "🔗";
            font-size: 12px;
        }

        .fallback-link {
            background-color: #fafcff;
            border-radius: 16px;
            padding: 14px 16px;
            border: 1px solid #e9edf2;
            font-size: 13px;
            word-break: break-all;
            font-family: 'SF Mono', 'Menlo', monospace;
            color: #1e293b;
            line-height: 1.4;
        }

        /* security warning card */
        .security-warning {
            background: #fffbeb;
            border-left: 4px solid #f97316;
            border-radius: 20px;
            padding: 18px 20px;
            margin: 28px 0 24px;
        }

        .security-warning strong {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            color: #c2410c;
            margin-bottom: 10px;
        }

        .security-warning p {
            font-size: 14px;
            color: #7c5c2c;
            margin: 0;
            line-height: 1.5;
        }

        .expiry-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #fff1e6;
            border-radius: 40px;
            padding: 5px 12px;
            font-size: 12px;
            font-weight: 500;
            color: #c2410c;
            margin-top: 12px;
        }

        /* ignore note */
        .ignore-note {
            background: #f8fafc;
            border-radius: 20px;
            padding: 18px 20px;
            margin: 24px 0 16px;
            border: 1px solid #eef2f8;
        }

        .ignore-note p {
            font-size: 14px;
            color: #4b5565;
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }

        /* support section */
        .support-section {
            margin-top: 24px;
            padding-top: 16px;
            font-size: 13px;
            color: #5b6e8c;
            border-top: 1px solid #edf2f7;
        }

        .support-section a {
            color: #f97316;
            text-decoration: none;
            font-weight: 500;
        }

        /* footer */
        .footer {
            background: #fafcff;
            padding: 24px 32px 28px;
            text-align: center;
            border-top: 1px solid #eef2f6;
            font-size: 12px;
            color: #6f7c91;
        }

        .footer p {
            margin: 6px 0;
        }

        .footer a {
            color: #f97316;
            text-decoration: none;
            font-weight: 500;
        }

        .divider {
            width: 40px;
            height: 2px;
            background: #e2e8f0;
            margin: 12px auto;
            border-radius: 2px;
        }

        @media (max-width: 540px) {
            .content {
                padding: 28px 24px;
            }
            .header {
                padding: 32px 24px;
            }
            .reset-button {
                padding: 12px 28px;
                font-size: 15px;
            }
            .security-warning, .ignore-note {
                padding: 16px 18px;
            }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <!-- header with lock icon and warm gradient -->
        <div class="header">
            <div class="lock-icon">
                <span>🔐</span>
            </div>
            <h1>Reset Your Password</h1>
            <p>Secure your account in just one click</p>
        </div>

        <!-- main content -->
        <div class="content">
            <div class="greeting">
                <h2>Hello {{name}},</h2>
                <p>We received a request to reset the password for your <strong>{{appName}}</strong> account. No worries — you can create a new one below.</p>
            </div>

            <!-- primary CTA button -->
            <div class="btn-container">
                <a href="{{resetLink}}" class="reset-button">Reset password →</a>
            </div>

            <!-- fallback link section -->
            <div class="link-box">
                <div class="link-label">Or copy this secure link</div>
                <div class="fallback-link">
                    {{resetLink}}
                </div>
            </div>

            <!-- security warning with expiry info -->
            <div class="security-warning">
                <strong>
                    <span>⏱️</span> Important security information
                </strong>
                <p>This password reset link will expire in <strong>1 hour</strong> for your protection. After expiration, you'll need to request a new reset link.</p>
                <div class="expiry-badge">
                    <span>🕒</span> Valid for 60 minutes
                </div>
            </div>

            <!-- ignore section if request wasn't made -->
            <div class="ignore-note">
                <p>
                    <span style="font-size: 18px;">🛡️</span>
                    <span><strong>Didn't request this?</strong> You can safely ignore this email. Your password will remain unchanged, and no one can access your account without your approval.</span>
                </p>
            </div>

            <!-- support info -->
            <div class="support-section">
                <p>If you continue to receive these emails without requesting them, please contact our support team at <a href="mailto:{{supportEmail}}">{{supportEmail}}</a> for assistance.</p>
            </div>
        </div>

        <!-- footer -->
        <div class="footer">
            <p>© 2024 {{appName}}. All rights reserved.</p>
            <div class="divider"></div>
            <p>This is an automated security message — please do not reply directly.</p>
            <p style="margin-top: 8px;">
                <a href="{{appUrl}}">{{appDomain}}</a> • 
                <a href="{{helpUrl}}">Help Center</a>
            </p>
        </div>
    </div>
</body>
</html>