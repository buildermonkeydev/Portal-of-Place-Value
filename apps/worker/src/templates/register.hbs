<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to {{appName}}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.5;
            color: #1a1e2b;
            background-color: #f4f7fb;
            margin: 0;
            padding: 32px 16px;
        }
        .email-container {
            max-width: 560px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 24px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.02), 0 2px 6px rgba(0, 0, 0, 0.05);
            overflow: hidden;
        }
        /* subtle gradient header */
        .header {
            background: linear-gradient(135deg, #f0f9ff 0%, #e6f0fa 100%);
            padding: 40px 32px 32px 32px;
            text-align: center;
            border-bottom: 1px solid #e9edf2;
        }
        .logo-placeholder {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
        }
        .brand-icon {
            width: 48px;
            height: 48px;
            background: #ffffff;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.02), 0 1px 2px rgba(0, 0, 0, 0.05);
        }
        .brand-icon span {
            font-size: 28px;
            font-weight: 600;
            background: linear-gradient(120deg, #2563eb, #3b82f6);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        h1 {
            font-size: 28px;
            font-weight: 600;
            color: #0f172a;
            letter-spacing: -0.3px;
            margin: 8px 0 0 0;
        }
        .header-sub {
            font-size: 15px;
            color: #475569;
            margin-top: 8px;
        }
        .content {
            padding: 36px 32px 32px 32px;
            background: #ffffff;
        }
        .greeting {
            margin-bottom: 24px;
        }
        .greeting h2 {
            font-size: 22px;
            font-weight: 600;
            color: #0f172a;
            margin-bottom: 8px;
            letter-spacing: -0.2px;
        }
        .greeting p {
            font-size: 16px;
            color: #334155;
            margin-bottom: 16px;
        }
        .message-card {
            background-color: #fafcff;
            border-radius: 20px;
            padding: 24px;
            margin: 24px 0;
            border: 1px solid #eef2f8;
            box-shadow: 0 1px 2px rgba(0,0,0,0.02);
        }
        .btn-wrapper {
            text-align: center;
            margin: 28px 0 24px;
        }
        .button {
            display: inline-block;
            background-color: #2563eb;
            color: white;
            padding: 12px 28px;
            font-weight: 500;
            font-size: 16px;
            text-decoration: none;
            border-radius: 40px;
            transition: all 0.2s ease;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(255,255,255,0.1);
        }
        .button:hover {
            background-color: #1d4ed8;
            transform: translateY(-1px);
            box-shadow: 0 8px 16px -8px rgba(37, 99, 235, 0.3);
        }
        .link-box {
            background-color: #f8fafc;
            border-radius: 16px;
            padding: 14px 16px;
            margin: 20px 0 12px;
            border: 1px solid #e2e8f0;
            font-size: 13px;
            word-break: break-all;
            font-family: 'SF Mono', 'Menlo', monospace;
            color: #1e293b;
        }
        .link-label {
            font-size: 13px;
            font-weight: 500;
            color: #475569;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .link-label:before {
            content: "🔗";
            font-size: 12px;
            opacity: 0.7;
        }
        .expiry-badge {
            display: inline-flex;
            align-items: center;
            background: #f1f5f9;
            border-radius: 40px;
            padding: 4px 12px;
            font-size: 13px;
            color: #334155;
            margin-top: 8px;
        }
        .expiry-badge span {
            margin-right: 6px;
            font-size: 14px;
        }
        .ignore-note {
            margin-top: 32px;
            padding-top: 20px;
            border-top: 1px solid #eef2f6;
            font-size: 14px;
            color: #5b6e8c;
            background: #ffffff;
        }
        .footer {
            background-color: #fafcff;
            padding: 24px 32px 28px;
            text-align: center;
            border-top: 1px solid #ecf3f9;
            font-size: 12px;
            color: #5f6c84;
        }
        .footer p {
            margin: 4px 0;
        }
        .footer a {
            color: #3b82f6;
            text-decoration: none;
        }
        hr {
            border: none;
            border-top: 1px solid #eef2f8;
            margin: 16px 0;
        }
        @media (max-width: 480px) {
            .content {
                padding: 28px 24px;
            }
            .header {
                padding: 32px 24px 24px;
            }
            .button {
                padding: 10px 24px;
                font-size: 15px;
            }
            h1 {
                font-size: 26px;
            }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <!-- Header with clean brand accent -->
        <div class="header">
            <div class="logo-placeholder">
                <div class="brand-icon">
                    <span>✦</span>
                </div>
            </div>
            <h1>Welcome to {{appName}}</h1>
            <div class="header-sub">Join a space built for simplicity & clarity</div>
        </div>

        <!-- Main content: clear and friendly -->
        <div class="content">
            <div class="greeting">
                <h2>Hey {{name}},</h2>
                <p>Thanks for choosing <strong>{{appName}}</strong> — we’re really glad you’re here. <br>
                One quick step and you’re all set.</p>
            </div>

            <div class="message-card">
                <p style="font-weight: 500; margin-bottom: 8px;">✅ Verify your email address</p>
                <p style="font-size: 15px; color: #2c3e66;">Click the button below to confirm your account and unlock full access. This helps us keep your account secure.</p>
                
                <div class="btn-wrapper">
                    <a href="{{verificationLink}}" class="button">Verify email address →</a>
                </div>
                
                <div class="link-label">Or copy this secure link</div>
                <div class="link-box">
                    {{verificationLink}}
                </div>
                
                <div class="expiry-badge">
                    <span>⏱️</span> Link valid for 24 hours
                </div>
            </div>

            <div class="ignore-note">
                <p style="display: flex; gap: 10px; align-items: flex-start;">
                    <span style="font-size: 18px;">🕊️</span> 
                    <span>Didn't request this? No worries — you can safely ignore this email. No changes will be made to your email unless you verify.</span>
                </p>
            </div>
        </div>

        <!-- Footer: minimal & clean -->
        <div class="footer">
            <p>© 2024 {{appName}}. All rights reserved.</p>
            <p style="font-size: 11px;">This message was automatically sent — please don’t reply directly.</p>
            <hr style="width: 48px; margin: 12px auto;">
            <p style="font-size: 11px; color: #7e8aa2;">
                {{appName}} · Crafted for simplicity
            </p>
        </div>
    </div>
</body>
</html>