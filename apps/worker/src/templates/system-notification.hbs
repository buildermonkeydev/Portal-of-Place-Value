<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - {{appName}}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Oxygen, Ubuntu, Cantarell, sans-serif;
            background-color: #f4f6fb;
            color: #1f2933;
            line-height: 1.5;
        }

        .container {
            max-width: 640px;
            margin: 0 auto;
            padding: 32px 20px;
        }

        /* Main card with modern glassmorphism touch */
        .card {
            background-color: #ffffff;
            border-radius: 28px;
            padding: 36px 36px 40px;
            box-shadow: 0 20px 35px -12px rgba(0, 0, 0, 0.08), 0 1px 2px rgba(0, 0, 0, 0.02);
            border: 1px solid #eef2f9;
            transition: transform 0.2s ease;
        }

        /* badge styling with dynamic color support */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 6px 14px;
            border-radius: 100px;
            background-color: #eef2ff;
            color: #4f46e5;
            margin-bottom: 24px;
            width: fit-content;
        }

        /* dynamic priority color via style attribute or inline variable */
        .title {
            font-size: 28px;
            font-weight: 700;
            margin: 0 0 12px;
            color: #111928;
            line-height: 1.3;
            letter-spacing: -0.3px;
        }

        .subtitle {
            margin: 0;
            color: #5b6e8c;
            font-size: 16px;
            line-height: 1.5;
            font-weight: 450;
        }

        /* main content area */
        .content {
            margin-top: 28px;
            line-height: 1.65;
            color: #2c3e50;
            font-size: 15px;
        }

        .content p {
            margin: 0 0 18px;
        }

        .content strong {
            color: #111928;
            font-weight: 600;
        }

        .content ul, .content ol {
            margin: 12px 0 20px;
            padding-left: 24px;
        }

        .content li {
            margin: 8px 0;
        }

        /* custom html wrapper */
        .custom-html {
            margin: 24px 0 16px;
            padding: 0;
        }

        /* call to action button */
        .cta {
            margin-top: 36px;
            text-align: center;
        }

        .cta a {
            display: inline-block;
            padding: 14px 32px;
            border-radius: 44px;
            text-decoration: none;
            font-weight: 600;
            font-size: 15px;
            background: linear-gradient(105deg, #4f46e5 0%, #6366f1 100%);
            color: #ffffff;
            box-shadow: 0 4px 10px rgba(79, 70, 229, 0.25);
            transition: all 0.2s ease;
            letter-spacing: -0.2px;
        }

        .cta a:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(79, 70, 229, 0.3);
            background: linear-gradient(105deg, #4338ca 0%, #4f46e5 100%);
        }

        /* secondary link style (optional) */
        .secondary-link {
            margin-top: 20px;
            text-align: center;
        }

        .secondary-link a {
            color: #6c757d;
            font-size: 13px;
            text-decoration: none;
            border-bottom: 1px dashed #cbd5e1;
        }

        /* footer styling */
        .footer {
            margin-top: 28px;
            font-size: 12px;
            color: #8b9ab0;
            text-align: center;
            line-height: 1.6;
        }

        .footer a {
            color: #4f46e5;
            text-decoration: none;
            font-weight: 500;
        }

        .footer a:hover {
            text-decoration: underline;
        }

        .footer p {
            margin: 8px 0;
        }

        .divider {
            width: 48px;
            height: 2px;
            background: #e2e8f0;
            margin: 16px auto;
            border-radius: 2px;
        }

        /* responsiveness */
        @media (max-width: 540px) {
            .container {
                padding: 20px 16px;
            }
            .card {
                padding: 28px 24px;
                border-radius: 24px;
            }
            .title {
                font-size: 24px;
            }
            .badge {
                font-size: 11px;
                padding: 5px 12px;
            }
            .cta a {
                padding: 12px 28px;
                font-size: 14px;
            }
        }

        /* subtle animation for badge (just visual flair) */
        @keyframes fadeSlide {
            0% { opacity: 0; transform: translateY(4px);}
            100% { opacity: 1; transform: translateY(0);}
        }
        .card {
            animation: fadeSlide 0.35s ease-out;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <!-- badge with category icon + dynamic priority color via inline style -->
            <div class="badge" style="background-color: {{badgeBgColor}}; color: {{priorityColor}};">
                {{#if categoryIcon}}
                    {{categoryIcon}}&nbsp;
                {{else}}
                    📢&nbsp;
                {{/if}}
                {{category}}
            </div>

            <h1 class="title">{{title}}</h1>
            <p class="subtitle">{{message}}</p>

            <!-- main content block: dynamic description / rich text -->
            <div class="content">
                {{#if contentText}}
                    <p>{{contentText}}</p>
                {{/if}}
                
                {{#if additionalDetails}}
                    <div style="margin-top: 12px;">
                        {{{additionalDetails}}}
                    </div>
                {{/if}}
            </div>

            <!-- custom HTML injection: flexible for any extra markup -->
            {{#if customHtml}}
            <div class="custom-html">
                {{{customHtml}}}
            </div>
            {{/if}}

            <!-- call to action button (if action is required) -->
            {{#if hasAction}}
            <div class="cta">
                <a href="{{actionUrl}}" target="_blank" rel="noopener noreferrer">
                    {{#if actionText}}
                        {{actionText}}
                    {{else}}
                        View details →
                    {{/if}}
                </a>
            </div>
            {{/if}}

            <!-- optional secondary / subtle link -->
            {{#if secondaryLinkText}}
            <div class="secondary-link">
                <a href="{{secondaryLinkUrl}}" target="_blank" rel="noopener noreferrer">{{secondaryLinkText}}</a>
            </div>
            {{/if}}
        </div>

        <!-- footer: app branding and support info -->
        <div class="footer">
            <p>Sent by <strong>{{appName}}</strong> • <a href="{{appUrl}}">{{appDomain}}</a></p>
            <div class="divider"></div>
            <p>
                Need help? <a href="{{helpUrl}}">Visit the help center</a> 
                or email <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>
            </p>
            <p style="font-size: 11px; margin-top: 12px; color: #9aaebf;">
                This is an automated message — please do not reply directly.
            </p>
        </div>
    </div>
</body>
</html>