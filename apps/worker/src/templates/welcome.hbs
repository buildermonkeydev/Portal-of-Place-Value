<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to {{appName}}!</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.5;
            background-color: #f5f7fc;
            margin: 0;
            padding: 32px 20px;
        }
        .email-wrapper {
            max-width: 580px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 28px;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.05), 0 2px 6px rgba(0, 0, 0, 0.02);
            overflow: hidden;
        }
        /* modern gradient header with soft edge */
        .header {
            background: linear-gradient(125deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%);
            padding: 44px 32px 36px 32px;
            text-align: center;
            color: white;
            position: relative;
        }
        .header h1 {
            font-size: 32px;
            font-weight: 700;
            letter-spacing: -0.4px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .header p {
            font-size: 16px;
            opacity: 0.92;
            font-weight: 450;
            margin-top: 4px;
        }
        .content {
            padding: 40px 36px 36px 36px;
            background: #ffffff;
        }
        .greeting h2 {
            font-size: 24px;
            font-weight: 600;
            color: #1e1f2c;
            margin-bottom: 12px;
            letter-spacing: -0.2px;
        }
        .greeting p {
            font-size: 16px;
            color: #4a5568;
            margin-bottom: 28px;
            line-height: 1.5;
        }
        .section-title {
            font-size: 18px;
            font-weight: 600;
            color: #2d3748;
            margin: 28px 0 16px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .feature-grid {
            display: flex;
            flex-direction: column;
            gap: 14px;
            margin: 20px 0 16px;
        }
        .feature-card {
            background: #fafbff;
            border-radius: 20px;
            padding: 18px 20px;
            border: 1px solid #edf2f7;
            transition: all 0.2s;
            display: flex;
            align-items: flex-start;
            gap: 14px;
        }
        .feature-icon {
            font-size: 26px;
            min-width: 44px;
            height: 44px;
            background: white;
            border-radius: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 6px rgba(0,0,0,0.02);
        }
        .feature-text {
            flex: 1;
        }
        .feature-text strong {
            font-size: 16px;
            font-weight: 600;
            color: #1f2937;
            display: block;
            margin-bottom: 6px;
        }
        .feature-text span {
            font-size: 14px;
            color: #5b6e8c;
            line-height: 1.4;
        }
        .btn-container {
            text-align: center;
            margin: 36px 0 28px;
        }
        .primary-btn {
            display: inline-block;
            background: linear-gradient(105deg, #6366f1 0%, #8b5cf6 100%);
            color: white;
            padding: 14px 36px;
            font-size: 16px;
            font-weight: 600;
            text-decoration: none;
            border-radius: 44px;
            box-shadow: 0 6px 14px rgba(99, 102, 241, 0.25);
            transition: transform 0.15s ease, box-shadow 0.2s;
            letter-spacing: -0.2px;
        }
        .primary-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 22px rgba(99, 102, 241, 0.3);
        }
        .help-section {
            background: #f9fafc;
            border-radius: 24px;
            padding: 24px 24px;
            margin: 32px 0 12px;
            border: 1px solid #eff3f8;
        }
        .help-section h3 {
            font-size: 18px;
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .contact-list {
            list-style: none;
            padding: 0;
            margin: 12px 0 4px;
        }
        .contact-list li {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
            font-size: 15px;
            color: #2c3e66;
        }
        .contact-list li:before {
            content: "•";
            color: #8b5cf6;
            font-weight: bold;
            font-size: 18px;
        }
        .support-link {
            color: #6366f1;
            text-decoration: none;
            font-weight: 500;
            border-bottom: 1px dashed #cbd5e1;
        }
        .footer {
            background: #ffffff;
            padding: 24px 36px 32px;
            text-align: center;
            border-top: 1px solid #edf2f7;
            font-size: 12px;
            color: #7c8ba0;
        }
        .footer p {
            margin: 6px 0;
        }
        .footer .copyright {
            margin-top: 12px;
            font-size: 11px;
        }
        hr {
            border: none;
            border-top: 1px solid #eef2f8;
            margin: 8px 0;
        }
        @media (max-width: 520px) {
            .content {
                padding: 32px 24px;
            }
            .header h1 {
                font-size: 28px;
            }
            .feature-card {
                padding: 14px 16px;
            }
            .primary-btn {
                padding: 12px 28px;
                font-size: 15px;
            }
        }
    </style>
</head>
<body>
    <div class="email-wrapper">
        <!-- header with celebration emoji + modern gradient -->
        <div class="header">
            <h1>
                <span>🎉</span> Welcome to {{appName}}!
            </h1>
            <p>Your account is now active and ready to use</p>
        </div>

        <!-- main content: fresh and engaging -->
        <div class="content">
            <div class="greeting">
                <h2>Hello {{name}},</h2>
                <p>Welcome to <strong>{{appName}}</strong>! We're thrilled to have you join our community. Your account has been successfully verified and is ready to use.</p>
            </div>

            <!-- what's next section with modern cards -->
            <div class="section-title">
                <span>✨</span> What's next?
            </div>
            <div class="feature-grid">
                <div class="feature-card">
                    <div class="feature-icon">📱</div>
                    <div class="feature-text">
                        <strong>Complete Your Profile</strong>
                        <span>Add your details, avatar, and preferences — make your space feel like home.</span>
                    </div>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🔧</div>
                    <div class="feature-text">
                        <strong>Explore Features</strong>
                        <span>Discover powerful tools, dashboards, and everything {{appName}} has to offer.</span>
                    </div>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">💬</div>
                    <div class="feature-text">
                        <strong>Join the Community</strong>
                        <span>Connect with creators, share ideas, and grow together.</span>
                    </div>
                </div>
            </div>

            <!-- primary CTA button -->
            <div class="btn-container">
                <a href="{{appUrl}}" class="primary-btn">Get Started Now →</a>
            </div>

            <!-- help section with clean layout and dynamic placeholders -->
            <div class="help-section">
                <h3>
                    <span>💡</span> Need Help?
                </h3>
                <p style="margin-bottom: 16px; color: #3a4a6e; font-size: 14px;">If you have any questions or need assistance, don't hesitate to reach out. We're here to help!</p>
                <ul class="contact-list">
                    <li>📧 Email: <a href="mailto:support@{{appDomain}}" class="support-link">support@{{appDomain}}</a></li>
                    <li>💬 Live Chat: Available 24/7 — right inside your dashboard</li>
                    <li>📚 Help Center: <a href="{{helpUrl}}" class="support-link">{{helpUrl}}</a></li>
                </ul>
            </div>

            <p style="margin-top: 28px; font-size: 15px; color: #2c3e66; border-left: 3px solid #8b5cf6; padding-left: 16px;">
                Thank you for choosing <strong>{{appName}}</strong>. We look forward to seeing what you'll create!
            </p>
        </div>

        <!-- footer: minimal, brand oriented -->
        <div class="footer">
            <p>© 2024 {{appName}}. All rights reserved.</p>
            <p style="font-size: 11px;">This is an automated message, please do not reply to this email.</p>
            <hr style="width: 40px; margin: 12px auto;">
  
        </div>
    </div>
</body>
</html>