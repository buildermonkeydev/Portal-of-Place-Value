# Application Configuration
APP_NAME="place value Portal"
APP_VERSION="1.0.0"
APP_URL="https://place value Portal.com"
APP_DOMAIN="place value Portal.com"
HELP_URL="https://place value Portal.com/help"
NODE_ENV="development"
PORT=3000
HOST="localhost"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,https://place value Portal.com"
CORS_CREDENTIALS=true

# Database Configuration
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="place value Portal"
DB_USERNAME="postgres"
DB_PASSWORD="password"
DB_SSL=false
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=30000

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"
REDIS_RETRY_DELAY=100
REDIS_MAX_RETRIES=3
REDIS_LAZY_CONNECT=true
REDIS_KEEP_ALIVE=30000
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000

# SMTP Configuration
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER="your_mailtrap_username"
SMTP_PASS="your_mailtrap_password"
SMTP_FROM="noreply@place value Portal.com"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-here-must-be-at-least-32-characters"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-here-must-be-at-least-32-characters"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_ISSUER="place value Portal.com"
JWT_AUDIENCE="place value Portal-users"

# Security Configuration
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=false
SESSION_SECRET="your-super-secret-session-key-here-must-be-at-least-32-characters"
COOKIE_SECRET="your-super-secret-cookie-key-here-must-be-at-least-32-characters"

# Cache Configuration
CACHE_TTL=3600
CACHE_PREFIX="cache:"
CACHE_MAX_KEYS=10000

# Session Configuration
SESSION_TTL=86400
SESSION_MAX_PER_USER=5
SESSION_PREFIX="session:"

# Queue Configuration
QUEUE_PREFIX="queue:"
QUEUE_DEFAULT_PRIORITY=0
QUEUE_MAX_RETRIES=3
QUEUE_MAIL_CONCURRENCY=5
QUEUE_NOTIFICATIONS_CONCURRENCY=10
QUEUE_DATA_PROCESSING_CONCURRENCY=3

# Worker Configuration
WORKER_MAIL_CONCURRENCY=5
WORKER_NOTIFICATION_CONCURRENCY=10
WORKER_DATA_PROCESSING_CONCURRENCY=3

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESS=false
RATE_LIMIT_SKIP_FAILED=false

# Logging Configuration
LOG_LEVEL="info"
LOG_FORMAT="json"
LOG_ENABLE_CONSOLE=true
LOG_ENABLE_FILE=false
LOG_FILE_PATH="logs/app.log"
LOG_MAX_FILES=5
LOG_MAX_SIZE="10mb"

# Monitoring Configuration
MONITORING_ENABLE_METRICS=true
MONITORING_ENABLE_HEALTH_CHECK=true
MONITORING_HEALTH_CHECK_PATH="/health"
MONITORING_METRICS_PATH="/metrics"
MONITORING_ENABLE_PROMETHEUS=false
MONITORING_PROMETHEUS_PORT=9090

# URL Configuration
ASSESSMENTS_URL="https://place value Portal.com/assessments"
LOGIN_URL="https://place value Portal.com/login"
REGISTER_URL="https://place value Portal.com/register"
DASHBOARD_URL="https://place value Portal.com/dashboard"
LEADERBOARD_URL="https://place value Portal.com/leaderboard"
RESULT_URL="https://place value Portal.com/result"

# Judge0 API Configuration
JUDGE0_API_URL_FIRST="http://localhost:2358"
JUDGE0_API_URL_SECOND="http://localhost:2359"
JUDGE0_API_URL_THIRD="http://localhost:2360"
JUDGE0_API_URL_FOURTH="http://localhost:2361"
JUDGE0_API_URL_FIFTH="http://localhost:2362"

# External Services (Optional)
# AWS Configuration
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="your-aws-access-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
# AWS_S3_BUCKET="your-s3-bucket"

# Stripe Configuration
# STRIPE_PUBLIC_KEY="pk_test_..."
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# SendGrid Configuration
# SENDGRID_API_KEY="SG.your-sendgrid-api-key"
# SENDGRID_FROM_EMAIL="noreply@place value Portal.com"

# Twilio Configuration
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# TWILIO_FROM_NUMBER="+1234567890"
