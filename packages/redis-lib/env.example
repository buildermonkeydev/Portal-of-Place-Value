a# Redis Configuration
# Use either REDIS_URL (recommended) or individual settings

# Redis URL (includes host, port, password, db)
# Format: redis://[password@]host[:port][/db]
REDIS_URL=redis://localhost:6379/0

# Individual Redis settings (used if REDIS_URL is not set)
REDIS_PASSWORD=your_redis_password
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# Cache Configuration
REDIS_CACHE_TTL=3600
REDIS_CACHE_PREFIX=cache:
REDIS_CACHE_MAX_KEYS=10000

# Session Configuration
REDIS_SESSION_TTL=86400
REDIS_SESSION_MAX_PER_USER=5
REDIS_SESSION_PREFIX=session:

# Queue Configuration
REDIS_QUEUE_PREFIX=queue:
REDIS_QUEUE_DEFAULT_PRIORITY=0
REDIS_QUEUE_MAX_RETRIES=3
