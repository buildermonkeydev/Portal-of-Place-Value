{
  "name": "@repo/redis-lib",
  "version": "1.0.0",
  "private": true,
  "description": "Production-level Redis client library with connection pooling, caching, and session management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./cache": {
      "import": "./dist/cache/index.js",
      "require": "./dist/cache/index.js",
      "types": "./dist/cache/index.d.ts"
    },
    "./session": {
      "import": "./dist/session/index.js",
      "require": "./dist/session/index.js",
      "types": "./dist/session/index.d.ts"
    },
    "./pubsub": {
      "import": "./dist/pubsub/index.js",
      "require": "./dist/pubsub/index.js",
      "types": "./dist/pubsub/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage"
  },
  "keywords": [
    "redis",
    "cache",
    "session",
    "queue",
    "pubsub",
    "typescript",
    "production"
  ],
  "jest": {
    "preset": "@repo/jest-presets/node"
  },
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "@repo/logger": "workspace:*",
    "@repo/env-config": "workspace:*",

    "bullmq": "^5.58.9",
    "handlebars": "^4.7.8",
    "ioredis": "^5.8.0",
    "nodemailer": "^6.10.1",
    "redis": "^4.6.12"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@repo/jest-presets": "workspace:*",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.11.24",
    "jest": "^29.7.0",
    "typescript": "^5.5.4"
  }
}
